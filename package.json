{
  "name": "ctx-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop": "electron .",
    "desktop:build": "npm run build && electron .",
    "desktop:smoke": "npm run build && node scripts/desktop-smoke.mjs && electron . --smoke",
    "desktop:flow": "npm run build && node scripts/electron-flow-smoke.mjs",
    "start:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-windows.ps1",
    "runner": "node scripts/ctxlab-runner.mjs",
    "runner:check": "node scripts/ctxlab-runner.mjs --dry-run",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "smoke": "node scripts/smoke-dist.mjs",
    "verify": "npm test && npm run build && npm run smoke"
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "playwright-core": "^1.60.0",
    "vite": "^6.0.0"
  }
}
